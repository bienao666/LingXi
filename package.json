{
  "name": "lingxi-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "灵犀 AI 助手：真实聊天与长期记忆",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "check": "tsc -p frontend/tsconfig.json --noEmit && node frontend/scripts/check.mjs",
    "test": "node --test frontend/tests/*.test.mjs",
    "build": "npm run check && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1",
    "api:types": "openapi-typescript backend/openapi.json -o frontend/src/api.generated.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
