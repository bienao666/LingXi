{
  "id": "rhine-lab-boot",
  "version": "1.2.0",
  "defaults": {
    "theme": "light",
    "speed": 1,
    "interaction": "auto",
    "sound": false,
    "volume": 0.12,
    "speech": false,
    "speechRate": 1.1,
    "speechVolume": 0.65,
    "readyTimeout": 30000,
    "stallTimeout": 15000,
    "reducedMotion": "auto",
    "brand": {
      "name": "灵犀",
      "latin": "LINGXI",
      "tagline": "与你并肩 · 一点就通",
      "logoUrl": "./assets/lingxi.svg"
    },
    "identity": {
      "name": "个人工作空间",
      "code": "LINGXI / WORKSPACE",
      "level": "身份确认"
    },
    "audio": {
      "tick": "",
      "confirm": "",
      "complete": ""
    }
  },
  "typography": {
    "display": "\"Bahnschrift\", \"DIN Alternate\", \"Arial Narrow\", \"Microsoft YaHei\", \"PingFang SC\", sans-serif",
    "mono": "\"Cascadia Mono\", \"SFMono-Regular\", Consolas, Menlo, monospace",
    "body": "\"Microsoft YaHei\", \"PingFang SC\", \"Hiragino Sans GB\", \"Noto Sans CJK SC\", sans-serif",
    "titleSize": "40px",
    "titleWeight": "400",
    "titleLine": "1.4",
    "titleTracking": "0.16em",
    "subtitleSize": "13px",
    "subtitleTracking": "0.28em",
    "bodySize": "14px",
    "bodyLine": "1.65",
    "metaSize": "12px",
    "brandSize": "30px",
    "brandWeight": "700",
    "brandLine": "1.12",
    "brandTracking": "-0.02em",
    "subtitleLine": "1.8",
    "metaLine": "1.6",
    "metaTracking": "0.12em",
    "welcomeSize": "28px",
    "welcomeWeight": "700",
    "welcomeLine": "1.3",
    "welcomeTracking": "0.1em",
    "welcomeNameSize": "20px"
  },
  "layout": {
    "mobilePadding": "16px",
    "tabletPadding": "28px",
    "desktopPadding": "48px",
    "contentMax": "960px",
    "controlMin": "44px",
    "cardMax": "420px",
    "radius": "2px",
    "layer": "1000"
  },
  "motion": {
    "fast": 100,
    "transition": 320,
    "enter": 560,
    "curve": "cubic-bezier(0.16, 0.84, 0.24, 1)"
  },
  "themes": {
    "light": {
      "bg": "#e5e3df",
      "surface": "#eceae6",
      "ink": "#151513",
      "secondary": "#484742",
      "muted": "#605e59",
      "border": "#7a7871",
      "hair": "rgba(21,21,19,0.12)",
      "accent": "#a84800",
      "signal": "#ff7500",
      "box": "#151513",
      "boxInk": "#ffffff",
      "focus": "#914000",
      "wash": "#f5f3ee",
      "glitchA": "#af3529",
      "glitchB": "#22658c"
    },
    "dark": {
      "bg": "#0b0b0c",
      "surface": "#171719",
      "ink": "#f2f1ee",
      "secondary": "#cecdc8",
      "muted": "#a6a49e",
      "border": "#817f79",
      "hair": "rgba(242,241,238,0.14)",
      "accent": "#ffad69",
      "signal": "#ff7500",
      "box": "#f2f1ee",
      "boxInk": "#0b0b0c",
      "focus": "#ffad69",
      "wash": "#343438",
      "glitchA": "#ff8c80",
      "glitchB": "#81c9ed"
    }
  },
  "stages": [
    {
      "id": "brand",
      "duration": 2000,
      "transition": "tighten-sweep",
      "zh": "灵犀",
      "en": "LINGXI",
      "log": "灵犀界面启动",
      "trigger": "time"
    },
    {
      "id": "wash",
      "duration": 600,
      "transition": "wash",
      "zh": "唤醒界面",
      "en": "AWAKENING WORKSPACE",
      "log": "载入本地界面",
      "trigger": "time"
    },
    {
      "id": "plate",
      "duration": 800,
      "transition": "stagger",
      "zh": "个人空间",
      "en": "PERSONAL WORKSPACE",
      "log": "界面启动序列已建立",
      "trigger": "time"
    },
    {
      "id": "access",
      "duration": 1200,
      "transition": "type",
      "zh": "载入导航",
      "en": "LOADING NAVIGATION",
      "log": "读取本地菜单配置",
      "button": "继续浏览",
      "trigger": "confirm"
    },
    {
      "id": "identity",
      "duration": 1200,
      "transition": "type",
      "zh": "身份确认",
      "en": "IDENTITY VERIFICATION",
      "log": "确认身份后进入个人工作空间",
      "button": "确认身份",
      "trigger": "confirm"
    },
    {
      "id": "request",
      "duration": 1200,
      "transition": "type",
      "zh": "准备视图",
      "en": "PREPARING VIEW",
      "log": "准备页面布局",
      "trigger": "time"
    },
    {
      "id": "read",
      "duration": 1800,
      "transition": "scan",
      "zh": "读取界面",
      "en": "LOADING INTERFACE",
      "log": "等待本地界面就绪",
      "trigger": "ready"
    },
    {
      "id": "verified",
      "duration": 1200,
      "transition": "settle",
      "zh": "界面就绪",
      "en": "INTERFACE READY",
      "log": "本地框架载入完成",
      "trigger": "time"
    },
    {
      "id": "welcome",
      "duration": 2000,
      "transition": "welcome",
      "zh": "欢迎回来",
      "en": "WELCOME TO",
      "log": "欢迎进入灵犀工作空间",
      "trigger": "time"
    },
    {
      "id": "handoff",
      "duration": 800,
      "transition": "glitch-fade",
      "zh": "进入灵犀",
      "en": "ENTERING LINGXI",
      "log": "界面启动序列完成",
      "trigger": "time"
    }
  ],
  "responsive": {
    "mobileMax": 767,
    "tabletMax": 1023,
    "compactMaxHeight": 520,
    "mobile": {
      "titleSize": "clamp(24px,6.4vw,32px)",
      "titleTracking": "0.08em",
      "subtitleSize": "11px",
      "subtitleTracking": "0.12em",
      "brandSize": "22px",
      "welcomeSize": "22px",
      "welcomeNameSize": "16px"
    },
    "compact": {
      "brandSize": "18px"
    }
  },
  "components": {
    "cardLabelWidth": "80px",
    "cardGap": "16px",
    "cardRowPadding": "10px 4px",
    "actionPadding": "12px 28px",
    "actionMinWidth": "180px",
    "focusWidth": "3px",
    "focusOffset": "4px"
  },
  "effects": {
    "introBg": "#050506",
    "introInk": "#f2f1ee",
    "introSecondary": "#cecdc8",
    "introMuted": "#a6a49e",
    "introFocus": "#ffad69",
    "tightenDuration": 1500,
    "streakDuration": 600,
    "glitchDuration": 320,
    "ringDuration": 7000
  }
}
