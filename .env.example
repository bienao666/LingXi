# Generate independent secrets with: python -m lingxi.cli configure (PYTHONPATH=backend)
LINGXI_ENCRYPTION_KEY=CHANGE_ENCRYPTION_KEY
DB_PASSWORD=CHANGE_DB_PASSWORD
HINDSIGHT_DB_PASSWORD=CHANGE_HINDSIGHT_DB_PASSWORD
LINGXI_DATABASE_URL=postgresql+psycopg://lingxi:CHANGE_DB_PASSWORD@db:5432/lingxi
LINGXI_RUNTIME_DIR=/app/runtime
LINGXI_HINDSIGHT_URL=http://hindsight:8888
LINGXI_MEMORY_GATEWAY_TOKEN=CHANGE_MEMORY_GATEWAY_TOKEN
LINGXI_MEMORY_EMBEDDING_DIMENSIONS=1024
# Local HTTP only. Set true and use HTTPS for remote/server access.
LINGXI_COOKIE_SECURE=false
LINGXI_PUBLIC_ORIGIN=http://localhost:8080
WEB_BIND=127.0.0.1:8080
# Hindsight calls the Core's private gateway. Configure verified extraction,
# multilingual embedding and rerank policies through the model management UI.
# No provider API key is stored in the Hindsight environment.
# Replace with digest after deployment verification; tag is pinned for the candidate adapter.
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:1.1.0-slim
