        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url",
          "method",
          "effect"
        ],
        "title": "ApiEntry"
      },
      "ApiParameter": {
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "object",
              "array"
            ],
            "title": "Type"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "title": "Description",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "title": "ApiParameter"
      },
      "Capability": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "native",
              "skill",
              "api",
              "mcp",
              "agent",
              "event"
