          "ttl_seconds": {
            "type": "integer",
            "maximum": 604800.0,
            "minimum": 60.0,
            "title": "Ttl Seconds",
            "default": 86400
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_types"
        ],
        "title": "EventEntry"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
