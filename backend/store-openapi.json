  "components": {
    "schemas": {
      "AgentEntry": {
        "properties": {
          "expertise": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Expertise"
          },
          "instructions": {
            "type": "string",
            "maxLength": 4000,
            "title": "Instructions",
            "default": ""
          },
          "completion": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Completion"
          },
          "tools": {
            "items": {
              "type": "string",
              "enum": [
                "reason",
                "server.files",
                "plugin.call"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Tools"
          },
          "context_categories": {
            "items": {
              "type": "string",
              "enum": [
                "profile",
                "preferences",
                "experiences",
                "projects",
                "relationships",
                "procedures",
                "support"
              ]
            },
            "type": "array",
            "maxItems": 7,
            "title": "Context Categories"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expertise",
          "completion"
        ],
        "title": "AgentEntry"
      },
      "ApiEntry": {
        "properties": {
          "auth": {
            "type": "string",
            "enum": [
              "none",
              "bearer",
              "api_key",
              "oauth2"
            ],
            "title": "Auth",
            "default": "none"
          },
          "oauth": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OAuthEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Url"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ],
            "title": "Method"
          },
          "effect": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ],
            "title": "Effect"
          },
          "key_header": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9-]{0,63}$",
            "title": "Key Header",
            "default": "X-API-Key"
          },
          "parameters": {
            "items": {
              "$ref": "#/components/schemas/ApiParameter"
            },
            "type": "array",
            "maxItems": 32,
            "title": "Parameters"
          },
          "health_url": {
            "type": "string",
            "maxLength": 1000,
            "title": "Health Url",
            "default": ""
