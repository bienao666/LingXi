          },
          "mcp": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/McpEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "agent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentEntry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind"
        ],
        "title": "Capability"
      },
      "Decision": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "withdraw",
              "republish",
              "revoke"
            ],
            "title": "Action"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "action",
          "note"
